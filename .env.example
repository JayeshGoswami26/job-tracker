# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/job-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/job-tracker?retryWrites=true&w=majority

# Optional: MongoDB Database name (defaults to "job-tracker" if omitted)
MONGODB_DB=job-tracker
